---
import type { PromotionConfig } from '../types';
import { assertPromotionConfig } from '../validation';

interface Props {
  promotion: PromotionConfig;
  side: 'left' | 'right';
  mobileMode?: 'hide' | 'dock';
  reopenDelayMs?: number;
  hideWhenVisible?: string[];
  hideAtMaxWidth?: number;
  label?: string;
  preview?: boolean;
}

const {
  promotion, side, mobileMode = 'hide', reopenDelayMs = 90000,
  hideWhenVisible = [], hideAtMaxWidth = 1840, label = 'Promoción lateral', preview = false,
} = Astro.props;
assertPromotionConfig(promotion);
const target = promotion.target ?? '_self';
---

<aside
  class:list={['ad-rail', `ad-rail--${side}`, { 'ad-rail--dock': mobileMode === 'dock' }]}
  aria-label={label}
  data-ad-rail
  data-ad-id={promotion.id}
  data-preview={preview}
  data-reopen-delay={Math.max(0, reopenDelayMs)}
  data-hide-selectors={JSON.stringify(hideWhenVisible)}
  data-hide-max-width={hideAtMaxWidth}
>
  <button class="ad-rail__close" type="button" data-ad-rail-collapse aria-label="Minimizar promoción">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
  </button>
  <a class="ad-rail__media" href={promotion.href} target={target} rel={target === '_blank' ? 'noopener noreferrer' : undefined} aria-label={promotion.ctaLabel} data-ad-rail-click>
    {promotion.media.type === 'video' ? (
      <video src={promotion.media.src} poster={promotion.media.poster} muted autoplay loop playsinline aria-label={promotion.media.alt}></video>
    ) : (
      <picture>
        {promotion.media.mobileAvifSrc && <source media="(max-width: 680px)" srcset={promotion.media.mobileAvifSrc} type="image/avif" />}
        {promotion.media.mobileSrc && <source media="(max-width: 680px)" srcset={promotion.media.mobileSrc} />}
        {promotion.media.avifSrc && <source srcset={promotion.media.avifSrc} type="image/avif" />}
        <img src={promotion.media.src} alt={promotion.media.alt} width={promotion.media.width} height={promotion.media.height} loading="lazy" decoding="async" />
      </picture>
    )}
  </a>
  <button class="ad-rail__tab" type="button" data-ad-rail-expand aria-label="Mostrar promoción">Promo</button>
</aside>

<script>
  function initializeRails() {
    document.querySelectorAll<HTMLElement>('[data-ad-rail]:not([data-preview="true"])').forEach((root) => {
      if (root.dataset.adReady === 'true') return;
      root.dataset.adReady = 'true';
      const id = root.dataset.adId ?? '';
      const delay = Number(root.dataset.reopenDelay ?? 90000);
      let reopenTimer: number | undefined;
      const expand = () => { window.clearTimeout(reopenTimer); root.classList.remove('is-minimized'); root.dispatchEvent(new CustomEvent('admodule:open', { bubbles: true, detail: { id, placement: 'rail' } })); };
      const collapse = () => {
        root.classList.add('is-minimized');
        root.dispatchEvent(new CustomEvent('admodule:dismiss', { bubbles: true, detail: { id, placement: 'rail' } }));
        if (Number.isFinite(delay) && delay > 0) reopenTimer = window.setTimeout(() => { if (root.isConnected) expand(); }, delay);
      };
      root.querySelector('[data-ad-rail-collapse]')?.addEventListener('click', collapse);
      root.querySelector('[data-ad-rail-expand]')?.addEventListener('click', expand);
      root.querySelector<HTMLAnchorElement>('[data-ad-rail-click]')?.addEventListener('click', (event) => {
        root.dispatchEvent(new CustomEvent('admodule:click', { bubbles: true, detail: { id, placement: 'rail', href: event.currentTarget instanceof HTMLAnchorElement ? event.currentTarget.href : '' } }));
      });
      let selectors: string[] = [];
      try { selectors = JSON.parse(root.dataset.hideSelectors ?? '[]'); } catch { /* No exclusions. */ }
      if (!selectors.length || !('IntersectionObserver' in window)) return;
      const maxWidth = Number(root.dataset.hideMaxWidth ?? 1840);
      const media = window.matchMedia(`(max-width: ${maxWidth}px)`);
      const visible = new Set<Element>();
      const update = () => { root.dataset.obscured = String(media.matches && visible.size > 0); };
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => entry.isIntersecting ? visible.add(entry.target) : visible.delete(entry.target));
        update();
      });
      selectors.forEach((selector) => {
        try { document.querySelectorAll(selector).forEach((element) => observer.observe(element)); } catch { /* Ignore an invalid site selector. */ }
      });
      media.addEventListener('change', update);
      update();
      document.addEventListener('astro:before-swap', () => { observer.disconnect(); media.removeEventListener('change', update); window.clearTimeout(reopenTimer); }, { once: true });
    });
  }
  initializeRails();
  document.addEventListener('astro:page-load', initializeRails);
</script>

<style>
  .ad-rail, .ad-rail * { box-sizing: border-box; }
  .ad-rail { position: fixed; z-index: 25; top: 50%; width: 14.375rem; aspect-ratio: 804 / 1956; overflow: hidden; transform: translateY(-50%); border: 1px solid rgb(255 255 255 / .2); background: #111; box-shadow: 0 .875rem 2.5rem rgb(0 0 0 / .28); }
  .ad-rail[data-obscured="true"] { visibility: hidden; pointer-events: none; }
  .ad-rail--left { left: 1.125rem; }
  .ad-rail--right { right: 1.125rem; }
  .ad-rail__media, .ad-rail__media picture, .ad-rail__media img, .ad-rail__media video { display: block; width: 100%; height: 100%; }
  .ad-rail__media img, .ad-rail__media video { object-fit: contain; }
  .ad-rail__close { position: absolute; z-index: 2; top: .55rem; right: .55rem; display: grid; place-items: center; width: 2rem; height: 2rem; padding: .47rem; border: 1px solid rgb(255 255 255 / .55); border-radius: 50%; background: rgb(0 0 0 / .7); color: #fff; cursor: pointer; }
  .ad-rail__close svg { display: block; width: 100%; fill: none; stroke: currentColor; stroke-width: 1.9; stroke-linecap: round; }
  .ad-rail__tab { display: none; border: 0; background: #e6e500; color: #111; font: 800 .7rem/1 system-ui, sans-serif; letter-spacing: .1em; text-transform: uppercase; cursor: pointer; }
  .ad-rail.is-minimized { width: 2.625rem; height: 7rem; aspect-ratio: auto; }
  .ad-rail.is-minimized .ad-rail__media, .ad-rail.is-minimized .ad-rail__close { display: none; }
  .ad-rail.is-minimized .ad-rail__tab { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; writing-mode: vertical-rl; transform: rotate(180deg); }
  .ad-rail :is(a, button):focus-visible { outline: 3px solid #e6e500; outline-offset: -3px; }
  .ad-rail[data-preview="true"] { position: relative; top: auto; right: auto; left: auto; transform: none; }
  @media (max-width: 1320px) and (min-width: 681px) {
    .ad-rail { width: clamp(9.375rem, 22vw, 13.125rem); }
    .ad-rail--left { left: .625rem; }
    .ad-rail--right { right: .625rem; }
  }
  @media (max-width: 680px) {
    .ad-rail:not([data-preview="true"]) { display: none; }
    .ad-rail--dock:not([data-preview="true"]) { display: block; top: auto; right: auto; bottom: 0; left: 50%; width: min(calc(100% - 1.5rem), 32.5rem); height: auto; aspect-ratio: 2172 / 724; transform: translateX(-50%); border-radius: .625rem .625rem 0 0; }
    .ad-rail--dock.is-minimized:not([data-preview="true"]) { width: 10.25rem; height: auto; aspect-ratio: 2172 / 724; transform: translate(-50%, calc(100% - 2.25rem)); }
    .ad-rail--dock.is-minimized .ad-rail__tab { position: absolute; top: 0; left: 0; width: 100%; height: 2.25rem; writing-mode: horizontal-tb; transform: none; }
    .ad-rail--dock .ad-rail__media img, .ad-rail--dock .ad-rail__media video { object-position: center 42%; }
    .ad-rail[data-preview="true"] { width: min(14.375rem, 70vw); }
    .ad-rail--dock[data-preview="true"] { width: min(100%, 32.5rem); aspect-ratio: 2172 / 724; }
    .ad-rail--left[data-preview="true"] { display: none; }
  }
</style>
